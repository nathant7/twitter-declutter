{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "twitter-declutter@nathant7",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "name": "X+ // A Twitter Declutter Extension",
  "version": "2026.10.17",
  "description": "Clean up your X/Twitter experience by removing ads, clutter, and unwanted sections",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
